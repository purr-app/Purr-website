---
import { links } from '../config';
---

<footer class="site-footer container">
  <div>
    <a class="brand" href="/" aria-label="Purr home">
      <img src="/purr.svg" width="32" height="32" alt="Purr logo" />
      Purr
    </a>
    <p>A focused API client for HTTP and GraphQL.</p>
  </div>
  <nav aria-label="Footer">
    <a href={links.download}>Download</a>
    <a href={links.github}>GitHub ↗</a>
    <a href="/docs/">Docs</a>
    <a href="/changelog/">Changelog</a>
    <a href="/privacy/">Privacy</a>
    <a href={links.license}>License</a>
  </nav>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Purr</span>
    <span>
      <i class="status-dot"></i> macOS · Local-first
    </span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>
