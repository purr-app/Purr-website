---
import ProductMedia from './ProductMedia.astro';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  label: string;
  items: {
    label: string;
    image: ImageMetadata;
    mobile?: ImageMetadata;
    alt: string;
    description: string;
  }[];
  variant?: string;
}
const { id, label, items, variant = '' } = Astro.props;
---

<div class:list={['showcase', variant]} data-showcase>
  <div class="showcase-tabs" role="tablist" aria-label={label}>
    {items.map((item, i) => (
      <button
        type="button"
        id={`${id}-tab-${i}`}
        role="tab"
        aria-controls={`${id}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="tab-number" aria-hidden="true">
          0{i + 1}
        </span>
        {item.label}
      </button>
    ))}
  </div>
  <button class="showcase-rotation" type="button" aria-label={`Pause automatic previews: ${label}`}>
    Pause previews
  </button>
  {items.map((item, i) => (
    <div
      id={`${id}-panel-${i}`}
      role="tabpanel"
      aria-labelledby={`${id}-tab-${i}`}
      tabindex="0"
      hidden={i !== 0}
    >
      <ProductMedia
        src={item.image}
        mobile={item.mobile}
        alt={item.alt}
        caption={item.description}
      />
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((group) => {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...group.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const control = group.querySelector<HTMLButtonElement>('.showcase-rotation')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let visible = false;
    let stopped = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function schedule() {
      clearTimeout(timer);
      control.hidden = reduced.matches;
      control.textContent = stopped ? 'Resume previews' : 'Pause previews';
      control.setAttribute(
        'aria-label',
        `${stopped ? 'Resume' : 'Pause'} automatic previews: ${group.querySelector('[role="tablist"]')!.getAttribute('aria-label')}`,
      );
      if (!visible || stopped || reduced.matches || document.hidden) return;
      timer = setTimeout(() => {
        activate((active + 1) % tabs.length);
        schedule();
      }, 5500);
    }
    function stop(event: Event) {
      if ((event.target as Element).closest('.showcase-rotation')) return;
      stopped = true;
      schedule();
    }
    group.addEventListener('pointerdown', stop);
    group.addEventListener('focusin', stop);
    group.addEventListener('keydown', stop);
    control.addEventListener('click', () => {
      stopped = !stopped;
      schedule();
    });
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting && entry.intersectionRatio >= 0.35;
        schedule();
      },
      { threshold: [0, 0.35] },
    ).observe(group);
    document.addEventListener('visibilitychange', schedule);
    reduced.addEventListener('change', schedule);
    schedule();
    function activate(index: number, focus = false) {
      active = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (e) => {
        let next = index;
        if (e.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        else return;
        e.preventDefault();
        activate(next, true);
      });
    });
  });
</script>
