---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  name: string;
  poster: ImageMetadata;
  label: string;
  hero?: boolean;
}
const { name, poster, label, hero = false } = Astro.props;
const cover = await getImage({ src: poster, width: 1440, format: 'webp', quality: 85 });
const demoName =
  (
    { hero: 'Focus Mode', tracing: 'Jaeger tracing', jpath: 'JSONPath filtering' } as Record<
      string,
      string
    >
  )[name] || name;
---

<figure class:list={['video-frame', { 'hero-video': hero }]} data-video data-demo-name={demoName}>
  <video
    width="1920"
    height="1170"
    poster={cover.src}
    data-src={`/media/${name}.mp4`}
    data-mobile-src={`/media/${name}-mobile.mp4`}
    autoplay={hero}
    muted
    playsinline
    preload="none"
    aria-label={label}
  ></video>
  <figcaption class="video-caption">
    <span>
      <i class="status-dot"></i>
      {label}
    </span>
    <button type="button" class="video-toggle" aria-label={`Play demo: ${demoName}`}>
      Play demo <span aria-hidden="true">▶</span>
    </button>
  </figcaption>
</figure>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const saver = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((frame) => {
    const video = frame.querySelector('video')!;
    const button = frame.querySelector<HTMLButtonElement>('button')!;
    let manualPause = false;
    let manualPlay = false;
    let visible = false;
    let completed = false;
    const update = () => {
      const action = completed ? 'Replay' : video.paused ? 'Play' : 'Pause';
      button.textContent = `${action} demo ${completed ? '↻' : video.paused ? '▶' : 'Ⅱ'}`;
      button.setAttribute('aria-label', `${action} demo: ${frame.dataset.demoName}`);
    };
    const play = async () => {
      if (!video.src) {
        video.src = matchMedia('(max-width: 700px)').matches
          ? video.dataset.mobileSrc!
          : video.dataset.src!;
        video.load();
      }
      try {
        await video.play();
      } catch {
        update();
      }
    };
    const sync = () => {
      if (
        visible &&
        !document.hidden &&
        !manualPause &&
        !completed &&
        (manualPlay || (!reduced.matches && !saver))
      )
        void play();
      else video.pause();
    };
    video.addEventListener('play', update);
    video.addEventListener('pause', update);
    // Keep the final decoded frame visible. Re-entering the viewport never restarts a finished demo.
    video.addEventListener('ended', () => {
      completed = true;
      manualPlay = false;
      update();
    });
    button.addEventListener('click', () => {
      if (video.paused || completed) {
        if (completed) video.currentTime = 0;
        completed = false;
        manualPause = false;
        manualPlay = true;
        void play();
      } else {
        manualPause = true;
        manualPlay = false;
        video.pause();
      }
    });
    new IntersectionObserver(
      (entries) => {
        visible = entries[0].isIntersecting;
        sync();
      },
      { threshold: 0.15 },
    ).observe(frame);
    reduced.addEventListener('change', () => {
      if (reduced.matches) manualPlay = false;
      sync();
    });
    document.addEventListener('visibilitychange', sync);
  });
</script>
