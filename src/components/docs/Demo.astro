---
import type { ImageMetadata } from 'astro';
interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  caption: string;
}
const { src, poster, label, caption } = Astro.props;
---

<figure class="docs-media docs-demo">
  <video
    controls
    playsinline
    muted
    preload="none"
    width="1600"
    height="1000"
    poster={poster.src}
    aria-label={label}
  >
    <source src={src} type="video/mp4" />
    <a href={src}>Download the demo video</a>
  </video>
  <figcaption>{caption}</figcaption>
</figure>
