---
interface Props {
  entries: { id: string; data: { title: string } }[];
  current: string;
}
const { entries, current } = Astro.props;
const basics = ['getting-started', 'workspaces-and-environments'];
const api = ['requests', 'responses', 'graphql'];
const groups = [
  { title: 'Basics', entries: entries.filter((entry) => basics.includes(entry.id)) },
  { title: 'Requests and responses', entries: entries.filter((entry) => api.includes(entry.id)) },
  { title: 'Guides', entries: entries.filter((entry) => ![...basics, ...api].includes(entry.id)) },
];
---

<a href="/docs/" aria-current={!current ? 'page' : undefined}>
  Overview
</a>
{groups.map((group) => (
  <details class="docs-nav-group" open>
    <summary>
      {group.title}
      <span class="docs-nav-chevron" aria-hidden="true"></span>
    </summary>
    <div class="docs-nav-items">
      {group.entries.map((entry) => (
        <a href={`/docs/${entry.id}/`} aria-current={entry.id === current ? 'page' : undefined}>
          {entry.data.title}
        </a>
      ))}
    </div>
  </details>
))}
