---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  mobile?: boolean;
}
const { headings, mobile = false } = Astro.props;
// Keep long guides scannable: H2s and at most two H3s per section, never H4+.
let children = 0;
const outline = headings.filter((h) => {
  if (h.depth === 2) {
    children = 0;
    return true;
  }
  return h.depth === 3 && ++children <= 2;
});
---

{outline.length > 0 &&
  (mobile ? (
    <details class="docs-toc-mobile" data-docs-toc>
      <summary>
        On this page <span data-toc-current></span>
      </summary>
      <nav aria-label="On this page, mobile">
        {outline.map((heading) => (
          <a href={`#${heading.slug}`} data-depth={heading.depth}>
            {heading.text}
          </a>
        ))}
      </nav>
    </details>
  ) : (
    <aside class="docs-toc" data-docs-toc>
      <p>On this page</p>
      <nav aria-label="On this page">
        {outline.map((heading) => (
          <a href={`#${heading.slug}`} data-depth={heading.depth}>
            {heading.text}
          </a>
        ))}
      </nav>
    </aside>
  ))}

<script>
  const tocs = [...document.querySelectorAll<HTMLElement>('[data-docs-toc]')];
  if (tocs.length) {
    const links = tocs.flatMap((toc) => [
      ...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'),
    ]);
    const sections = [...tocs[0].querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]
      .map((link) => ({
        link,
        heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
      }))
      .filter((section) => section.heading);
    let current = '';
    function activate(link: HTMLAnchorElement) {
      if (current === link.hash) return;
      current = link.hash;
      links.forEach((item) => {
        if (item.hash === current) item.setAttribute('aria-current', 'location');
        else item.removeAttribute('aria-current');
      });
      tocs.forEach((toc) => {
        const label = toc.querySelector('[data-toc-current]');
        if (label) label.textContent = link.textContent;
      });
    }
    function update() {
      let active = sections[0];
      for (const section of sections) {
        if (section.heading!.getBoundingClientRect().top <= 160) active = section;
      }
      if (active) activate(active.link);
    }
    const observer = new IntersectionObserver(update, {
      rootMargin: '-145px 0px 0px 0px',
      threshold: [0, 1],
    });
    sections.forEach(({ heading }) => observer.observe(heading!));
    window.addEventListener('hashchange', update);
    update();
    tocs
      .filter((toc) => toc instanceof HTMLDetailsElement)
      .forEach((toc) => {
        toc.querySelectorAll('a').forEach((link) =>
          link.addEventListener('click', () => {
            (toc as HTMLDetailsElement).open = false;
          }),
        );
      });
  }
</script>
