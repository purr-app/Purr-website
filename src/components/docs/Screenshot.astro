---
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  eager?: boolean;
}
const { src, alt, caption, eager = false } = Astro.props;
// Captures contain two physical pixels per CSS pixel. Serve the lossless master.
---

<figure class="docs-media docs-screenshot" style={`max-width: ${src.width / 2}px`}>
  <a
    href={src.src}
    target="_blank"
    rel="noopener"
    aria-label={`${alt}. Open full-size screenshot.`}
  >
    <img
      src={src.src}
      width={src.width}
      height={src.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <figcaption>
    {caption} <span aria-hidden="true">↗</span>
  </figcaption>
</figure>
