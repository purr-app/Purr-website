---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { description as defaultDescription } from '../config';
import '../styles/global.css';
import '../styles/refinements.css';
import '../styles/fonts.css';
import spaceFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Purr — A focused HTTP & GraphQL client for macOS',
  description = defaultDescription,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const indexingDisabled = import.meta.env.PUBLIC_NOINDEX === 'true';
const robots = noindex || indexingDisabled ? 'noindex, follow' : 'index, follow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0D13" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Purr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Purr — API work, with less UI in the way." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/purr.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={spaceFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <slot name="head" />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
