---
import Base from './Base.astro';
import ExplorePurr from '../components/ExplorePurr.astro';
import '../styles/feature-pages.css';
interface Props {
  title: string;
  description: string;
  name: string;
  variant: string;
}
const { title, description, name, variant } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const data = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', name: 'Purr', url: Astro.site?.href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Purr', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name, item: url },
      ],
    },
  ],
};
---

<Base title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
  ></script>
  <main id="main" class:list={['feature-page', variant]}>
    <nav class="feature-breadcrumb container" aria-label="Breadcrumb">
      <a href="/">Purr</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{name}</span>
    </nav>
    <slot />
    <ExplorePurr />
  </main>
</Base>
