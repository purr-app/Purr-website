---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const entries = (await getCollection('changelog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const releases = await Promise.all(
  entries.map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---

<Base
  title="Changelog — Purr"
  description="Follow releases and improvements to the Purr HTTP and GraphQL API client."
>
  <main id="main" class="container content-page">
    <header class="page-heading">
      <p class="eyebrow">PURR / CHANGELOG</p>
      <h1>
        A little better,
        <br />
        <span class="muted">with every release.</span>
      </h1>
      <p>New features, thoughtful improvements, and fixes.</p>
    </header>
    <div class="release-timeline">
      {releases.length ? (
        releases.map(({ entry, Content }) => (
          <article class="release-entry" id={`v${entry.data.version}`}>
            <h2>v{entry.data.version}</h2>
            <time datetime={entry.data.date.toISOString()}>
              {entry.data.date.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.summary}</p>
            <div class="prose">
              <Content />
            </div>
          </article>
        ))
      ) : (
        <article class="release-entry">
          <h2>Release notes are on their way.</h2>
          <span class="release-status">NO RELEASE NOTES PUBLISHED YET</span>
          <p class="empty-release">
            This is where you’ll find what’s added, improved, and fixed in Purr. In the meantime,
            take a look at the workflows already in the app.
          </p>
          <a class="text-link" href="/#features">
            Explore Purr →
          </a>
        </article>
      )}
    </div>
  </main>
</Base>
