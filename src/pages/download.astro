---
import Base from '../layouts/Base.astro';
import { links } from '../config';
---

<Base
  title="Download Purr for macOS"
  description="Get Purr, a focused HTTP and GraphQL API client for macOS."
  noindex
>
  <main id="main" class="container content-page narrow">
    <header class="page-heading">
      <p class="eyebrow">PURR / MACOS</p>
      <h1>
        Meet your
        <br />
        <span class="muted">next workspace.</span>
      </h1>
      <p>A focused API client for HTTP and GraphQL.</p>
    </header>
    <div class="prose notice-panel">
      <h2>The download link is coming soon.</h2>
      <p>
        A macOS download isn’t available on this website yet. Explore the app while the release link
        is being prepared.
      </p>
      <a class="button secondary" href="/#features">
        Explore Purr →
      </a>
      {links.github !== '/github/' && (
        <a class="text-link" href={links.github}>
          View on GitHub →
        </a>
      )}
    </div>
  </main>
</Base>
