---
import Base from '../layouts/Base.astro';
import { links } from '../config';
---

<Base
  title="Download Purr for macOS"
  description="Get Purr, a focused HTTP and GraphQL API client for macOS."
>
  <main id="main" class="container content-page narrow">
    <header class="page-heading">
      <p class="eyebrow">PURR / MACOS</p>
      <h1>
        Meet your
        <br />
        <span class="muted">next workspace.</span>
      </h1>
      <p>A focused API client for HTTP and GraphQL.</p>
    </header>
    <div class="prose notice-panel">
      <h2>Download Purr for macOS</h2>
      <p>The latest universal build supports Apple Silicon and Intel Macs.</p>
      <a class="button primary" href={links.download}>
        Download latest DMG ↓
      </a>
      <p>
        This preview is not yet Apple-signed or notarized. macOS may require approval in Privacy
        &amp; Security before opening it.
      </p>
      {
        <a class="text-link" href={links.github}>
          View on GitHub →
        </a>
      }
    </div>
  </main>
</Base>
