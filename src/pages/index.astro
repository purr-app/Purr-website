---
import Base from '../layouts/Base.astro';
import Actions from '../components/Actions.astro';
import Video from '../components/Video.astro';
import ProductMedia from '../components/ProductMedia.astro';
import Showcase from '../components/Showcase.astro';
import Icon from '../components/Icon.astro';
import composeMobile from '../assets/mobile/compose.webp';
import inspectMobile from '../assets/mobile/inspect.webp';
import adjustMobile from '../assets/mobile/adjust.webp';
import focusMobile from '../assets/mobile/focus.webp';
import vertical_modeMobile from '../assets/mobile/vertical_mode.webp';
import horisontal_modeMobile from '../assets/mobile/horisontal_mode.webp';
import hero from '../assets/hero.webp';
import tracing from '../assets/tracing.webp';
import compose from '../assets/compose.webp';
import inspect from '../assets/inspect.webp';
import adjust from '../assets/adjust.webp';
import vertical from '../assets/vertical_mode.webp';
import horizontal from '../assets/horisontal_mode.webp';
import focus from '../assets/focus.webp';
import queries from '../assets/gql_multi_queries-detail.webp';
import variables from '../assets/gql_var_form-detail.webp';
import schema from '../assets/gql_schema-detail.webp';
import autocomplete from '../assets/gql_autocomplete-detail.webp';
import dynamic from '../assets/dynamic_vars-detail.webp';
import filter from '../assets/filter.webp';
import timeline from '../assets/timeline-detail.webp';
const features = [
  'HTTP',
  'GraphQL',
  'Dynamic Variables',
  'jq',
  'JSONPath',
  'OpenAPI 3',
  'cURL Import',
  'Jaeger Tracing',
  'Encrypted Storage',
  'Request Timeline',
  'Focus Mode',
  'Horizontal Split',
  'Vertical Split',
  'Local Workspaces',
];
const application = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Purr',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS',
  description:
    'A focused, local-first HTTP and GraphQL API client with Focus Mode, Jaeger tracing, dynamic variables, and encrypted response storage.',
  ...(Astro.site?.hostname !== 'purr.example'
    ? { url: Astro.site?.href, image: new URL('/og.png', Astro.site).href }
    : {}),
  featureList: features,
};
---

<Base>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(application).replace(/</g, '\\u003c')}
  ></script>
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="ambient" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot"></span>A little less UI. A lot more focus.
        </p>
        <h1 id="hero-title">
          API work, with less
          <br />
          <span>UI in the way.</span>
        </h1>
        <p class="hero-description">
          A focused HTTP and GraphQL client that adapts the workspace around what you're doing —
          from request to response and trace.
        </p>
        <Actions />
        <p class="capabilities">
          Local-first <b>·</b> HTTP <b>·</b> GraphQL <b>·</b> Jaeger Tracing <b>·</b> Encrypted
          Storage
        </p>
      </div>
      <div class="hero-product">
        <Video name="hero" poster={hero} label="Compose. Inspect. Adjust. Stay in flow." hero />
      </div>
      <div class="hero-footnote">
        <span>YOUR API. YOUR WORKSPACE.</span>
        <span>
          Send requests, inspect responses, follow traces,
          <br class="desktop-break" /> and keep your workflow focused.
        </span>
        <a href="#features" aria-label="Explore Purr features">
          Explore Purr <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section
      id="features"
      class="feature-section container tracing-section"
      aria-labelledby="trace-title"
    >
      <div class="section-intro">
        <div>
          <p class="eyebrow">
            <span class="section-number">01 /</span> JAEGER TRACING
          </p>
          <h2 id="trace-title">
            Follow the request
            <br />
            <span class="muted">past the response.</span>
          </h2>
        </div>
        <div class="section-description">
          <p>Open the trace behind a request and see exactly where the time went.</p>
          <p class="small-copy">
            Purr integrates with Jaeger so you can move from the response to the trace without
            leaving your workflow.
          </p>
          <a class="text-link" href="/docs/tracing/">
            View trace <Icon name="arrow" />
          </a>
        </div>
      </div>
      <ol class="flow-line trace-flow" aria-label="Tracing workflow">
        <li>Request</li>
        <li>Response</li>
        <li class="active">Trace</li>
        <li>Jaeger spans</li>
        <li>Slow service / span</li>
      </ol>
      <Video name="tracing" poster={tracing} label="From a response to the spans behind it." />
      <div class="under-media">
        <span>
          <i class="status-dot"></i>Request → response → trace
        </span>
        <span>One workflow. All the context.</span>
      </div>
    </section>

    <section id="focus" class="feature-section container" aria-labelledby="focus-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">
            <span class="section-number">02 /</span> FOCUS MODE
          </p>
          <h2 id="focus-title">
            The workspace follows
            <br />
            <span class="muted">your attention.</span>
          </h2>
        </div>
        <div class="section-description">
          <p>
            Write the request with room to think.
            <br />
            Send it, and the response takes over.
          </p>
          <p class="small-copy">
            Need to change something? Expand the request again without losing your response.
          </p>
        </div>
      </div>
      <Showcase
        id="focus"
        label="Focus Mode workflow"
        variant="focus-showcase"
        items={[
          {
            label: 'Compose',
            image: compose,
            mobile: composeMobile,
            alt: 'Focus Mode with the HTTP request body taking the canvas',
            description: 'The request gets the canvas.',
          },
          {
            label: 'Inspect',
            image: inspect,
            mobile: inspectMobile,
            alt: 'After sending, the JSON response becomes primary and the request collapses',
            description: 'The response takes over.',
          },
          {
            label: 'Adjust',
            image: adjust,
            mobile: adjustMobile,
            alt: 'The request expanded again while the previous response remains visible below',
            description: 'Expand without losing context.',
          },
        ]}
      />
    </section>

    <section id="http" class="feature-section container" aria-labelledby="http-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow emerald">
            <span class="section-number">03 /</span> HTTP WORKFLOW
          </p>
          <h2 id="http-title">
            HTTP without
            <br />
            <span class="muted">the ceremony.</span>
          </h2>
        </div>
        <div class="section-description">
          <p>Build the request, send it, and inspect what came back.</p>
          <p class="small-copy">
            Headers, auth, body, timing and response data stay close without competing for your
            screen.
          </p>
          <a class="text-link" href="/docs/requests/">
            Explore requests <Icon name="arrow" />
          </a>
        </div>
      </div>
      <ProductMedia
        src={vertical}
        mobile={vertical_modeMobile}
        alt="Purr HTTP client showing a POST request to /case/planning/preview, its JSON body, and the 200 OK response side by side"
        caption="The request and the response. Everything you need, close at hand."
      />
      <div class="detail-strip">
        <span class="emerald">GET</span>
        <span class="blue">POST</span>
        <span>Headers</span>
        <span>Auth</span>
        <span>Body</span>
        <span>Response</span>
        <span>Timing</span>
      </div>
    </section>

    <section id="graphql" class="feature-section graphql-section" aria-labelledby="graphql-title">
      <div class="container">
        <div class="section-intro">
          <div>
            <p class="eyebrow magenta">
              <span class="section-number">04 /</span> FIRST-CLASS GRAPHQL
            </p>
            <h2 id="graphql-title">
              GraphQL deserves more
              <br />
              than a <span class="muted">JSON textbox.</span>
            </h2>
          </div>
          <div class="section-description">
            <p>
              Work with multiple operations, schema-aware editing, autocomplete, schema exploration,
              and structured variable forms without constantly switching between your query and raw
              JSON.
            </p>
            <a class="text-link" href="/docs/graphql/">
              Explore GraphQL <Icon name="arrow" />
            </a>
          </div>
        </div>
        <Showcase
          id="graphql"
          label="GraphQL features"
          variant="graphql-showcase"
          items={[
            {
              label: 'Queries',
              image: queries,
              alt: 'Two GraphQL operations, Cases and CaseDetails, each with its own send button',
              description: 'Multiple operations. Operation-level send.',
            },
            {
              label: 'Variables',
              image: variables,
              alt: 'Structured GraphQL variable form with a CaseStatus enum dropdown and page size input',
              description: 'Structured variables. Switch between Form and JSON.',
            },
            {
              label: 'Schema',
              image: schema,
              alt: 'GraphQL schema explorer showing queries, types, field arguments, and schema source',
              description: 'Explore the schema alongside its types and arguments.',
            },
            {
              label: 'Autocomplete',
              image: autocomplete,
              alt: 'Schema-aware autocomplete suggesting typename, assignee, and author in a GraphQL query',
              description: 'Schema-aware editing. Autocomplete where you need it.',
            },
          ]}
        />
      </div>
    </section>

    <section id="variables" class="feature-section container" aria-labelledby="variables-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">
            <span class="section-number">05 /</span> DYNAMIC VARIABLES
          </p>
          <h2 id="variables-title">
            Let one response
            <br />
            <span class="muted">feed the next request.</span>
          </h2>
        </div>
        <div class="section-description">
          <p>Extract values from a response and reuse them anywhere else in the workspace.</p>
          <p class="small-copy">
            No scripts just to pass an access token, ID, or generated value from one request into
            another.
          </p>
          <a class="text-link" href="/docs/variables/">
            Learn about variables <Icon name="arrow" />
          </a>
        </div>
      </div>
      <ol class="flow-line variable-flow" aria-label="Dynamic variable workflow">
        <li>Response</li>
        <li>Extract value</li>
        <li class="active">
          <code>dynamic variable</code>
        </li>
        <li>Reuse in a request</li>
      </ol>
      <ProductMedia
        src={dynamic}
        alt="Purr Variables UI with a dynamic assignee_id variable, JSONPath extraction strategy, cache settings, and resolved value"
        caption="Extract. Resolve. Reuse."
      />
    </section>

    <section id="filtering" class="feature-section container" aria-labelledby="filter-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">
            <span class="section-number">06 /</span> JQ + JSONPATH
          </p>
          <h2 id="filter-title">
            Query the response,
            <br />
            <span class="muted">not the scrollbar.</span>
          </h2>
        </div>
        <div class="section-description">
          <p>Filter JSON responses in place with jq or JSONPath.</p>
          <p class="small-copy">
            Keep the original response intact and inspect only the data you care about.
          </p>
          <a class="text-link" href="/docs/requests/#response-filtering">
            See filtering <Icon name="arrow" />
          </a>
        </div>
      </div>
      <ProductMedia
        src={filter}
        alt="A real Purr response filtered with JSONPath, showing the filter input and matching cases"
        caption="A smaller result. The original response stays intact."
      />
    </section>

    <section id="import" class="feature-section container" aria-labelledby="import-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">
            <span class="section-number">07 /</span> OPENAPI 3 + CURL
          </p>
          <h2 id="import-title">
            Bring your API
            <br />
            <span class="muted">with you.</span>
          </h2>
        </div>
        <div class="section-description">
          <p>
            Paste cURL or import an OpenAPI 3 specification and start working without rebuilding
            requests by hand.
          </p>
          <a class="text-link" href="/docs/openapi/">
            See import options <Icon name="arrow" />
          </a>
        </div>
      </div>
      <!-- No real import screenshot supplied. These are conceptual diagrams, not recreated product UI. Replace with approved import captures when available. -->
      <div class="import-diagrams">
        <figure class="import-diagram">
          <figcaption>
            <span class="mono blue">.yaml</span>
            <h3>Import OpenAPI 3</h3>
            <span class="diagram-label">WORKFLOW</span>
          </figcaption>
          <div class="file-flow">
            <div class="file-token">
              <span aria-hidden="true">&#123; &#125;</span>
              <code>openapi.yaml</code>
            </div>
            <span class="flow-arrow" aria-hidden="true">
              →
            </span>
            <div class="file-tree">
              <span>Workspace</span>
              <span>├─ Folders</span>
              <span>└─ Requests</span>
            </div>
          </div>
        </figure>
        <figure class="import-diagram">
          <figcaption>
            <Icon name="terminal" />
            <h3>Paste cURL</h3>
            <span class="diagram-label">WORKFLOW</span>
          </figcaption>
          <div class="file-flow">
            <div class="file-token">
              <span class="emerald" aria-hidden="true">
                $ _
              </span>
              <code>curl command</code>
            </div>
            <span class="flow-arrow" aria-hidden="true">
              →
            </span>
            <div class="file-tree">
              <span class="emerald">Parsed request</span>
              <span>URL · Headers</span>
              <span>Method · Body</span>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section id="timeline" class="feature-section container" aria-labelledby="timeline-title">
      <div class="section-intro">
        <div>
          <p class="eyebrow">
            <span class="section-number">08 /</span> REQUEST TIMELINE
          </p>
          <h2 id="timeline-title">
            Detailed
            <br />
            <span class="muted">request insights.</span>
          </h2>
        </div>
        <div class="section-description">
          <p>
            See connection time, TTFB, download time, headers, redirects, TLS details, and more
            without leaving the response.
          </p>
          <a class="text-link" href="/docs/requests/#request-timeline">
            Open timeline <Icon name="arrow" />
          </a>
        </div>
      </div>
      <div class="timing-legend">
        <span>
          <i></i>Prepare
        </span>
        <span>
          <i></i>Connection
        </span>
        <span>
          <i></i>TTFB
        </span>
        <span>
          <i></i>Download
        </span>
        <span>Every phase, in context.</span>
      </div>
      <ProductMedia
        src={timeline}
        alt="Request Timeline with prepare, connection, TTFB, and download timing, followed by request, HTTP headers, and TLS details"
        caption="The lifecycle of this request, from preparation to the last byte."
      />
    </section>

    <section
      id="encryption"
      class="feature-section container encryption-section"
      aria-labelledby="encryption-title"
    >
      <div class="privacy-copy">
        <div class="lock-symbol">
          <Icon name="lock" size={27} />
        </div>
        <p class="eyebrow">
          <span class="section-number">09 /</span> ENCRYPTED LOCAL STORAGE
        </p>
        <h2 id="encryption-title">
          Keep sensitive
          <br />
          <span class="muted">data safe.</span>
        </h2>
        <p>
          Store response data encrypted on your machine so local API history does not have to sit
          around as readable plaintext.
        </p>
        <a class="text-link" href="/docs/encryption/">
          Learn about encryption <Icon name="arrow" />
        </a>
      </div>
      <!-- Conceptual diagram: no settings image, algorithm or key-management claims were supplied. -->
      <figure class="encryption-diagram">
        <div class="diagram-heading">
          <span class="status-dot"></span>ON YOUR MACHINE
        </div>
        <div class="encryption-step">
          <span class="diagram-index">01</span>
          <span>Response stream</span>
          <code>&#123; … &#125;</code>
        </div>
        <div class="vertical-connector" aria-hidden="true"></div>
        <div class="encryption-step encryption-active">
          <span class="diagram-index">02</span>
          <span>Encryption</span>
          <Icon name="lock" />
        </div>
        <div class="vertical-connector" aria-hidden="true"></div>
        <div class="encryption-step">
          <span class="diagram-index">03</span>
          <span>Local storage</span>
          <span class="encrypted-dots" aria-hidden="true">
            ••••••
          </span>
        </div>
        <figcaption>Encrypt response storage.</figcaption>
      </figure>
    </section>

    <section id="layouts" class="feature-section container" aria-labelledby="layouts-title">
      <div class="centered-intro">
        <p class="eyebrow">
          <span class="section-number">10 /</span> YOUR WORKSPACE, YOUR WAY
        </p>
        <h2 id="layouts-title">
          Focused when you want it.
          <br />
          <span class="muted">Split when you need it.</span>
        </h2>
        <p>
          Use Focus Mode for a single task, or switch to horizontal and vertical splits whenever you
          want request and response visible together.
        </p>
      </div>
      <Showcase
        id="layouts"
        label="Workspace layout modes"
        items={[
          {
            label: 'Focus',
            image: focus,
            mobile: focusMobile,
            alt: 'Focus Mode with the Preview action weekend plan response taking the canvas',
            description: 'One task. Room to focus.',
          },
          {
            label: 'Vertical Split',
            image: vertical,
            mobile: vertical_modeMobile,
            alt: 'Vertical Split showing the same request and response side by side',
            description: 'Request and response, side by side.',
          },
          {
            label: 'Horizontal Split',
            image: horizontal,
            mobile: horisontal_modeMobile,
            alt: 'Horizontal Split showing the same request above its response',
            description: 'Request above. Response below.',
          },
        ]}
      />
    </section>

    <section class="feature-summary container" aria-labelledby="summary-title">
      <div>
        <p class="eyebrow">THE TOOLKIT</p>
        <h2 id="summary-title">
          More features.
          <br />
          <span class="muted">Less friction.</span>
        </h2>
      </div>
      <ul>
        {features.map((feature) => (
          <li>
            <span aria-hidden="true">✓</span>
            {feature}
          </li>
        ))}
      </ul>
    </section>
    <section class="final-cta container" aria-labelledby="cta-title">
      <img src="/purr.svg" width="64" height="64" alt="" loading="lazy" />
      <p class="eyebrow">GET INTO YOUR FLOW</p>
      <h2 id="cta-title">Try Purr.</h2>
      <p>Download it, point it at an API, and see if the workflow fits.</p>
      <Actions />
      <span class="mono final-note">macOS · Local-first</span>
    </section>
  </main>
</Base>
