---
import Base from '../layouts/Base.astro';
---

<Base
  title="Privacy — Purr"
  description="Privacy information for the Purr website and local response storage."
>
  <main id="main" class="container content-page narrow">
    <header class="page-heading">
      <p class="eyebrow">PURR / PRIVACY</p>
      <h1>
        Your workspace.
        <br />
        <span class="muted">On your machine.</span>
      </h1>
    </header>
    <div class="prose">
      <h2>The website</h2>
      <p>
        This website does not include analytics, advertising trackers, cookies, or forms that
        collect personal information. Fonts and product media are served from this website.
      </p>
      <p>
        The hosting provider may process standard connection information, such as an IP address,
        when serving the site. External links have their own privacy practices.
      </p>
      <h2>Response storage in Purr</h2>
      <p>
        Purr supports encrypted response storage on your machine so local API history does not have
        to sit around as readable plaintext.
      </p>
      <p>
        <a href="/docs/encryption/">Learn about encrypted response storage</a>.
      </p>
      <h2>App privacy information</h2>
      <p>
        The full app privacy notice is not published here yet. This page does not describe every
        aspect of the desktop app’s data handling.
      </p>
    </div>
  </main>
</Base>
